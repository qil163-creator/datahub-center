  "measurement": {
    "source": "8 张用户原始 PNG；色块边界通过像素扫描，区域与文本通过人工复核。",
    "sourcePixelsPerEstimatedCssPixel": 1.5,
    "scaleConfidence": "推断：顶部导航 90px、表单控件 48px、字号约 21px，与常见 CSS 的 60/32/14px 一致。最终 CSS 应以 REA 的运行时 computedStyle 为准。",
    "positionToleranceSourcePixels": 3,
    "textMeasurement": "字号、行高与字重为截图估算，不代表浏览器已确认的 computedStyle。"
  },
