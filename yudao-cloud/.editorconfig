root = true

# 数据中台业务模块及指定组件的正式源码统一采用四空格缩进，保留现有文件换行符。
[{yudao-module-asset/**/src/main/java,yudao-module-dataforge/**/src/main/java,yudao-module-governance/**/src/main/java,yudao-module-modeling/**/src/main/java,yudao-module-supply/**/src/main/java,yudao-framework/yudao-dbswitch/**/src/main/java,yudao-framework/yudao-spring-boot-starter-biz-dbswitch/src/main/java,yudao-framework/yudao-spring-boot-starter-biz-dolphinscheduler/src/main/java,yudao-framework/yudao-spring-boot-starter-biz-etl/src/main/java,yudao-framework/yudao-spring-boot-starter-biz-quality/src/main/java,yudao-framework/yudao-spring-boot-starter-biz-seatunnel/src/main/java}/**.java]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

ij_continuation_indent_size = 8
ij_java_blank_lines_after_class_header = 1
ij_java_blank_lines_around_field = 1
ij_java_blank_lines_around_field_with_annotations = 1
ij_java_blank_lines_around_method = 1
ij_java_class_annotation_wrap = split_into_lines
ij_java_method_annotation_wrap = split_into_lines
ij_java_field_annotation_wrap = split_into_lines
ij_java_do_not_wrap_after_single_annotation = false
ij_java_keep_simple_classes_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_control_statement_in_one_line = false
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always
ij_java_method_call_chain_wrap = normal
ij_java_call_parameters_wrap = normal
ij_java_method_parameters_wrap = normal
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_align_multiline_binary_operation = false
ij_java_align_multiline_ternary_operation = false
ij_java_enable_javadoc_formatting = false
ij_java_align_multiline_text_blocks = false
ij_java_strip_whitespace_from_blank_lines_in_text_blocks = false
