#if ( $schemaApi )
#set ($apiName = "${table.moduleName.substring(0,1).toUpperCase()}${table.moduleName.substring(1)}${simpleClassName}Api")
#else
#set ($apiName = "${simpleClassName}Api")
#end
#set ($wireTypes = {
  "long": "number | string", "integer": "number", "short": "number",
  "double": "number", "float": "number", "bigdecimal": "number",
  "date": "number | string", "localdatetime": "number | string",
  "localdate": "string", "localtime": "string"
})
## 读模型使用数据库主键，写模型允许新行尚未分配编号。内嵌子行的关联键由主表保存时填写。
#macro(writeModelFields $fields $save $parentKey)
#foreach ($column in $fields)
#if ($column.primaryKey || $column.createOperation || $column.updateOperation || (!$save && $column.listOperationResult))
#set ($optional = (!$column.primaryKey && ($column.nullable || !$column.createOperation)) || ($save && ($column.primaryKey || $column.javaField == $parentKey)))
    ${column.javaField}#if($optional)?#end: $wireTypes.getOrDefault($column.javaType.toLowerCase(), $column.javaType.toLowerCase()); // ${column.columnComment}
#end
#end
#end
#macro(writeChildProperties $suffix)
#if ( $table.templateType == 10 || $table.templateType == 12 )
#foreach ($sub in $subTables)
#set ($i = $foreach.index)
#set ($childClass = $subSimpleClassNames.get($i))
#set ($childField = $subClassNameVars.get($i))
#if ( $sub.subJoinMany )
    ${childField}s?: ${childClass}${suffix}[];
#else
    ${childField}?: ${childClass}${suffix};
#end
#end
#end
#end
#if ( $table.templateType != 2 )
import type { PageParam, PageResult } from '@vben/request';
#end

import { requestClient } from '#/api/request';
#set ($baseURL = "/${table.moduleName}/${simpleClassName_strikeCase}")

export namespace ${apiName} {
  export type Id = $wireTypes.getOrDefault($primaryColumn.javaType.toLowerCase(), $primaryColumn.javaType.toLowerCase());
#foreach ($subTable in $subTables)
#set ($index = $foreach.index)
#set ($subSimpleClassName = $subSimpleClassNames.get($index))
#set ($subColumns = $subColumnsList.get($index))
#set ($parentKey = "")
#if ($table.templateType != 11)
#set ($parentKey = $subJoinColumns.get($index).javaField)
#end

  /** ${subTable.classComment}信息 */
  export interface ${subSimpleClassName} {
#writeModelFields($subColumns false "")
  }

  /** ${subTable.classComment}保存参数 */
  export interface ${subSimpleClassName}Save {
#writeModelFields($subColumns true $parentKey)
  }
#end

  /** ${table.classComment}信息 */
  export interface ${simpleClassName} {
#writeModelFields($columns false "")
#if ($table.templateType == 2)
    children?: ${simpleClassName}[];
#end
#writeChildProperties("")
  }

  /** ${table.classComment}保存参数 */
  export interface ${simpleClassName}Save {
#writeModelFields($columns true "")
#writeChildProperties("Save")
  }
}

#if ( $table.templateType != 2 )
/** 查询${table.classComment}分页 */
export function get${simpleClassName}Page(params: PageParam) {
  return requestClient.get<PageResult<${apiName}.${simpleClassName}>>('${baseURL}/page', { params });
}
#else
/** 查询${table.classComment}列表 */
export function get${simpleClassName}List(params: any) {
  return requestClient.get<${apiName}.${simpleClassName}[]>('${baseURL}/list', { params });
}
#end

/** 查询${table.classComment}详情 */
export function get${simpleClassName}(id: ${apiName}.Id) {
  return requestClient.get<${apiName}.${simpleClassName}>(`${baseURL}/get?id=${id}`);
}

/** 新增${table.classComment} */
export function create${simpleClassName}(data: ${apiName}.${simpleClassName}Save) {
  return requestClient.post('${baseURL}/create', data);
}

/** 修改${table.classComment} */
export function update${simpleClassName}(data: ${apiName}.${simpleClassName}Save & { ${primaryColumn.javaField}: ${apiName}.Id }) {
  return requestClient.put('${baseURL}/update', data);
}

/** 删除${table.classComment} */
export function delete${simpleClassName}(id: ${apiName}.Id) {
  return requestClient.delete(`${baseURL}/delete?id=${id}`);
}

#if ( $table.templateType != 2 && $deleteBatchEnable)
/** 批量删除${table.classComment} */
export function delete${simpleClassName}List(ids: ${apiName}.Id[]) {
  return requestClient.delete(`${baseURL}/delete-list?ids=${ids.join(',')}`)
}
#end

/** 导出${table.classComment} */
export function export${simpleClassName}(params: any) {
  return requestClient.download('${baseURL}/export-excel', { params });
}
#if ($importEnable)

/** 下载${table.classComment}导入模板 */
export function import${simpleClassName}Template() {
  return requestClient.download('${baseURL}/get-import-template');
}

/** 导入${table.classComment} */
#if ($schemaApi)
export function import${simpleClassName}(file: File) {
  return requestClient.upload('${baseURL}/import', { file });
}
#else
export function import${simpleClassName}(data: FormData) {
  return requestClient.post('${baseURL}/import', data);
}
#end
#end

